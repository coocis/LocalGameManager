<Page x:Class="LocalGameManager.Views.StoreBrowserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:LocalGameManager.Views"
      Background="{DynamicResource PageBackgroundBrush}"
      Loaded="Page_Loaded">
    <Page.Resources>
        <local:ByteArrayImageConverter x:Key="ImageConverter"/>
    </Page.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Text="商店浏览" FontSize="28" FontWeight="SemiBold"/><Button Content="↻ 批量刷新信息" Click="RefreshFavorites_Click" Margin="18,0,0,0"/><Button Content="导出收藏" Click="ExportFavorites_Click" Margin="8,0,0,0"/><Button Content="导入收藏" Click="ImportFavorites_Click" Margin="8,0,0,0"/></StackPanel>
            <TextBlock x:Name="StatusText" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,22,0,14" Padding="10,7"
                 KeyDown="SearchBox_KeyDown" ToolTip="输入关键词后按 Enter 搜索 DLsite；留空时显示收藏"/>
        <ListBox x:Name="GamesList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch" PreviewMouseRightButtonDown="GamesList_RightClick">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="190" Height="265" Margin="7" Padding="12" Background="{DynamicResource SurfaceBrush}" CornerRadius="7">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="132"/>
                                <RowDefinition Height="78"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="#394D7E" CornerRadius="5">
                                <Image Source="{Binding CoverContent,Converter={StaticResource ImageConverter}}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding OriginalName}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="60" LineHeight="20" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Button Grid.Row="2" Content="{Binding FavoriteButtonText}" Tag="{Binding}" Click="Favorite_Click" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
