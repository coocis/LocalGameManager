<Page x:Class="LocalGameManager.Views.GameDetailsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource PageBackgroundBrush}" Loaded="Page_Loaded" PreviewKeyDown="Page_PreviewKeyDown">
 <DockPanel Margin="28">
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="← 返回游戏库" Click="Back_Click"/><Button Content="▶ 启动游戏" Click="Launch_Click" Background="#5267D5" Foreground="White" BorderBrush="Transparent"/><Button Content="打开游戏目录" Click="OpenGameFolder_Click"/><Button Content="重新选择游戏目录" Click="RelocateGame_Click"/><Button Content="保存修改" Click="Save_Click"/><Button Content="从资料库删除" Click="DeleteRecord_Click" Foreground="#B23B45"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
  <ScrollViewer Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel>
    <Border Height="300" Background="#394D7E" CornerRadius="8" MouseLeftButtonUp="CoverImage_MouseLeftButtonUp"><Image x:Name="CoverImage" Stretch="Uniform"/></Border><Button Content="导入/替换封面" Click="ImportCover_Click" Margin="0,8,0,0"/>
    <TextBlock Text="截图" FontWeight="SemiBold" Margin="0,18,0,6"/><Button Content="添加截图" Click="ImportScreenshots_Click"/><Border Height="150" Background="#202B46" CornerRadius="6" Margin="0,6,0,0" MouseLeftButtonUp="ScreenshotPreview_MouseLeftButtonUp"><Image x:Name="ScreenshotPreview" Stretch="Uniform"/></Border>
    <ListBox x:Name="ScreenshotsList" Height="76" Margin="0,6,0,0" SelectionChanged="ScreenshotsList_SelectionChanged"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Button Tag="{Binding Id}" Click="OpenScreenshot_Click" Padding="0" Margin="2"><Image Source="{Binding Image}" Width="62" Height="58" Stretch="UniformToFill"/></Button></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="删除选中的截图" Click="DeleteScreenshot_Click" HorizontalAlignment="Left" Margin="0,4,0,0"/>
    <TextBlock Text="图标状态" FontWeight="SemiBold" Margin="0,18,0,6"/><CheckBox x:Name="IsNewBox"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8.2,10.2 H12.3 A5.5,5.5 0 0 1 17.6,14.3 L18.4,17.3 A1.8,1.8 0 0 1 15.4,19.1 L13.7,17.6 H6.3 L4.6,19.1 A1.8,1.8 0 0 1 1.6,17.3 L2.4,14.3 A5.5,5.5 0 0 1 7.7,10.2 Z M6.2,14.8 H9.3 M7.75,13.25 V16.35 M13.7,14.8 H13.71 M16,13.8 H16.01 M17.7,3 L18.15,4.35 L19.5,4.8 L18.15,5.25 L17.7,6.6 L17.25,5.25 L15.9,4.8 L17.25,4.35 Z"/></Canvas></Viewbox><TextBlock Text="新游戏" VerticalAlignment="Center"/></StackPanel></CheckBox><CheckBox x:Name="IsFavoriteBox" Content="♥ 收藏"/><CheckBox x:Name="IsCompletedBox" Content="✓ 已经通关"/><CheckBox x:Name="IsTranslatedBox"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4.5,5.5 H19.5 V15.5 H11.5 L7.5,18.5 V15.5 H4.5 A2,2 0 0 1 2.5,13.5 V7.5 A2,2 0 0 1 4.5,5.5 Z"/><TextBlock Text="汉" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="8.5" Width="24" TextAlignment="Center" Margin="0,6,0,0"/></Canvas></Viewbox><TextBlock Text="已经汉化" VerticalAlignment="Center"/></StackPanel></CheckBox><CheckBox x:Name="IsUncensoredBox"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3.5,6.5 H20.5 V17.5 H3.5 Z M7,6.5 V9.6 M12,6.5 V9.6 M17,6.5 V9.6 M3.5,12 H6.6 M9,12 H12 M15,12 H17.5 M7,17.5 V14.4 M12,17.5 V14.4 M17,17.5 V14.4 M3,20.5 L21,3"/></Canvas></Viewbox><TextBlock Text="无码" VerticalAlignment="Center"/></StackPanel></CheckBox><CheckBox x:Name="IsAnimatedBox"><StackPanel Orientation="Horizontal"><Viewbox Width="20" Height="20" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2" Canvas.Left="3" Canvas.Top="5" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8"/><Path Fill="{DynamicResource TextPrimaryBrush}" Data="M9,9 L13,12 L9,15 Z"/><Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M20,7.5 C21.3,8.65 21.3,15.35 20,16.5 M18.3,9.5 C19,10.2 19,13.8 18.3,14.5"/></Canvas></Viewbox><TextBlock Text="动态" VerticalAlignment="Center"/></StackPanel></CheckBox><CheckBox x:Name="HasVoiceBox" Content="♬ 配音"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Margin="28,0,0,0">
    <TextBlock Text="游戏详情" FontSize="28" FontWeight="SemiBold"/>
    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,14,0"><TextBlock Text="译名"/><TextBox x:Name="TranslatedNameBox"/><TextBlock Text="原名" Margin="0,12,0,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OriginalNameBox"/><Button Grid.Column="1" Click="UpdateByOriginalName_Click" ToolTip="按原名查找并更新游戏信息"><Viewbox Width="16" Height="16"><Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M20,11 A8,8 0 1 0 20,13 M20,4 V11 H13"/></Viewbox></Button></Grid><TextBlock Text="社团名" Margin="0,12,0,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ClubNameBox"/><Button Grid.Column="1" Tag="ClubName" Click="FilterMetadata_Click" ToolTip="筛选社团"><Viewbox Width="16" Height="16"><Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" Data="M10.5,3 A7.5,7.5 0 1 0 10.5,18 A7.5,7.5 0 0 0 10.5,3 M16,16 L21,21"/></Viewbox></Button></Grid><TextBlock Text="作者" Margin="0,12,0,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AuthorsBox"/><Button Grid.Column="1" Tag="Authors" Click="FilterMetadata_Click" ToolTip="筛选作者"><Viewbox Width="16" Height="16"><Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" Data="M10.5,3 A7.5,7.5 0 1 0 10.5,18 A7.5,7.5 0 0 0 10.5,3 M16,16 L21,21"/></Viewbox></Button></Grid><TextBlock Text="插画师" Margin="0,12,0,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="IllustratorsBox"/><Button Grid.Column="1" Tag="Illustrators" Click="FilterMetadata_Click" ToolTip="筛选插画师"><Viewbox Width="16" Height="16"><Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" Data="M10.5,3 A7.5,7.5 0 1 0 10.5,18 A7.5,7.5 0 0 0 10.5,3 M16,16 L21,21"/></Viewbox></Button></Grid><TextBlock Text="声优" Margin="0,12,0,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="VoiceActorsBox"/><Button Grid.Column="1" Tag="VoiceActors" Click="FilterMetadata_Click" ToolTip="筛选声优"><Viewbox Width="16" Height="16"><Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" Data="M10.5,3 A7.5,7.5 0 1 0 10.5,18 A7.5,7.5 0 0 0 10.5,3 M16,16 L21,21"/></Viewbox></Button></Grid></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="评分"/><StackPanel x:Name="RatingStars" Orientation="Horizontal"><Button Tag="1" Content="☆" Click="RatingStar_Click" FontSize="24" Padding="1,0"/><Button Tag="2" Content="☆" Click="RatingStar_Click" FontSize="24" Padding="1,0"/><Button Tag="3" Content="☆" Click="RatingStar_Click" FontSize="24" Padding="1,0"/><Button Tag="4" Content="☆" Click="RatingStar_Click" FontSize="24" Padding="1,0"/><Button Tag="5" Content="☆" Click="RatingStar_Click" FontSize="24" Padding="1,0"/></StackPanel><TextBlock Text="发售日（YYYY-MM-DD）" Margin="0,12,0,0"/><TextBox x:Name="ReleaseDateBox"/><TextBlock Text="游戏引擎" Margin="0,12,0,0"/><TextBox x:Name="EngineBox"/><TextBlock Text="版本号" Margin="0,12,0,0"/><TextBox x:Name="VersionNumberBox"/></StackPanel>
    </Grid>
    <Grid Margin="0,20,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="作品形式" FontWeight="SemiBold"/><Button Grid.Column="1" Content="修改作品形式" Click="EditWorkForms_Click"/></Grid><ItemsControl x:Name="WorkFormsPanel"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource TagBrush}" CornerRadius="3" Margin="2"><StackPanel Orientation="Horizontal"><Button Content="{Binding Name}" Tag="{Binding Id}" Click="TagChip_Click" Background="Transparent" BorderBrush="Transparent" Padding="8,3" Margin="0"/><Button Content="×" Tag="{Binding Id}" Click="RemoveWorkForm_Click" Background="Transparent" BorderBrush="Transparent" Padding="5,3" Margin="0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Grid Margin="0,16,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="标签" FontWeight="SemiBold"/><Button Grid.Column="1" Content="修改标签" Click="EditTags_Click"/></Grid><ItemsControl x:Name="GameTagsPanel"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource TagBrush}" CornerRadius="3" Margin="2"><StackPanel Orientation="Horizontal"><Button Content="{Binding Name}" Tag="{Binding Id}" Click="TagChip_Click" Background="Transparent" BorderBrush="Transparent" Padding="8,3" Margin="0"/><Button Content="×" Tag="{Binding Id}" Click="RemoveCategoryTag_Click" Background="Transparent" BorderBrush="Transparent" Padding="5,3" Margin="0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="商店名称"/><TextBox x:Name="StoreNameBox"/><TextBlock Text="商店链接" Margin="0,12,0,0"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="StoreUrlBox"/><Button Grid.Column="1" Click="OpenStoreUrl_Click" ToolTip="在外部浏览器打开" Margin="8,2,0,2"><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M10,5 H5.5 A2.5,2.5 0 0 0 3,7.5 V18.5 A2.5,2.5 0 0 0 5.5,21 H16.5 A2.5,2.5 0 0 0 19,18.5 V14 M14,3 H21 V10 M21,3 L11.5,12.5"/></Canvas></Viewbox></Button><Button Grid.Column="2" Click="UpdateGameInfo_Click" ToolTip="更新游戏信息" Margin="4,2,0,2"><Viewbox Width="16" Height="16"><Path Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M20,11 A8,8 0 1 0 20,13 M20,4 V11 H13"/></Viewbox></Button></Grid><TextBlock Text="商店 ID" Margin="0,12,0,0"/><TextBox x:Name="StoreIdBox"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="DLC（每行一个名称）"/><TextBox x:Name="DlcsBox" Height="86" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></StackPanel></Grid>
    <TextBlock Text="作品内容" Margin="0,16,0,4"/><TextBox x:Name="DescriptionBox" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><TextBlock Text="评价" Margin="0,16,0,4"/><TextBox x:Name="ReviewBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><TextBlock Text="备注" Margin="0,16,0,4"/><TextBox x:Name="NotesBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><TextBlock Text="兼容性" Margin="0,16,0,4"/><TextBox x:Name="CompatibilityBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
    <TextBlock Text="启动选项" FontWeight="SemiBold" Margin="0,20,0,4"/><TextBlock Text="游戏可执行文件" Foreground="{DynamicResource TextSecondaryBrush}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ExecutablePathBox" ToolTip="可手动选择或输入游戏 EXE 路径"/><Button Grid.Column="1" Content="选择…" Click="ChooseExecutable_Click"/></Grid><CheckBox x:Name="UseMToolBox" Content="使用 MTOOL 启动（同目录的 与工具一同启动.bat）" Margin="0,6,0,0"/><CheckBox x:Name="StartRelayBox" Content="启动翻译中转器" Margin="0,6,0,0"/>
    <TextBlock Text="自动维护的信息" FontWeight="SemiBold" Margin="0,20,0,4"/><TextBlock x:Name="SystemInfoText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
   </StackPanel>
  </Grid></ScrollViewer>
 </DockPanel>
</Page>
