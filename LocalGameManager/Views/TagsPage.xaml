<Page x:Class="LocalGameManager.Views.TagsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource PageBackgroundBrush}" Loaded="Page_Loaded"><Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="标签管理" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock x:Name="StatusText" Text="同一类型内标签名称唯一；删除可解除关联或合并到另一个标签。" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel><WrapPanel Grid.Row="1" Margin="0,24,0,16"><TextBox x:Name="NameBox" Width="230" ToolTip="标签名称"/><ComboBox x:Name="TypeBox" Width="145" Margin="8,2" DisplayMemberPath="Display" SelectedValuePath="Value"/><Button Content="新增" Click="Add_Click" Background="#5267D5" Foreground="White" BorderBrush="Transparent"/><Button Content="保存修改" Click="SaveEdit_Click" Margin="8,2"/><Button Content="删除并解除关联" Click="Delete_Click" Margin="0,2"/><ComboBox x:Name="MergeTargetBox" Width="200" Margin="8,2" DisplayMemberPath="Display" SelectedValuePath="Id" ToolTip="选择合并目标"/><Button Content="合并到目标" Click="Merge_Click" Margin="0,2"/></WrapPanel><Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><ListView x:Name="TagsList" SelectionChanged="TagsList_SelectionChanged"><ListView.View><GridView><GridViewColumn Header="名称" DisplayMemberBinding="{Binding Name}" Width="260"/><GridViewColumn Header="类型" DisplayMemberBinding="{Binding TypeDisplay}" Width="180"/><GridViewColumn Header="关联游戏数" DisplayMemberBinding="{Binding GameCount}" Width="100"/></GridView></ListView.View></ListView></Border></Grid></Page>
