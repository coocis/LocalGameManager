<Page x:Class="LocalGameManager.Views.GameImageViewerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource PageBackgroundBrush}" Loaded="Page_Loaded">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="116"/></Grid.RowDefinitions>
    <DockPanel><Button Content="← 返回详情" Click="Back_Click" DockPanel.Dock="Left"/><TextBlock x:Name="TitleText" Text="图片浏览" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/></DockPanel>
    <Grid Grid.Row="1" Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Grid.Column="0" Content="❮" Click="Previous_Click" FontSize="34" Width="60" Margin="0,0,14,0" ToolTip="上一张"/>
      <Border Grid.Column="1" Background="#101725" CornerRadius="8"><Image x:Name="MainImage" Stretch="Uniform"/></Border>
      <Button Grid.Column="2" Content="❯" Click="Next_Click" FontSize="34" Width="60" Margin="14,0,0,0" ToolTip="下一张"/>
    </Grid>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="ThumbnailList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Id}" Click="Thumbnail_Click" Padding="0" Margin="0,0,8,0" BorderBrush="{DynamicResource BorderBrush}"><Image Source="{Binding Thumbnail}" Width="132" Height="94" Stretch="UniformToFill"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </Grid>
</Page>
