<Page x:Class="LocalGameManager.Views.StoreDetailsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LocalGameManager.Views" Background="{DynamicResource PageBackgroundBrush}" Loaded="Page_Loaded">
 <Page.Resources><local:ByteArrayImageConverter x:Key="ImageConverter"/></Page.Resources>
 <DockPanel Margin="28">
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="← 返回商店浏览" Click="Back_Click"/><Button Content="↻ 刷新信息" Click="Refresh_Click"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
  <ScrollViewer Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel><Border Height="300" Background="#394D7E" CornerRadius="8" MouseLeftButtonUp="CoverImage_MouseLeftButtonUp"><Image x:Name="CoverImage" Stretch="Uniform"/></Border><TextBlock x:Name="ScreenshotsTitle" Text="截图" FontWeight="SemiBold" Margin="0,18,0,6" Visibility="Collapsed"/><Border x:Name="ScreenshotPreviewBorder" Height="150" Background="#202B46" CornerRadius="6" Visibility="Collapsed" MouseLeftButtonUp="ScreenshotPreview_MouseLeftButtonUp"><Image x:Name="ScreenshotPreview" Stretch="Uniform"/></Border><ListBox x:Name="ScreenshotsList" Height="76" Margin="0,6,0,0" Visibility="Collapsed" SelectionChanged="ScreenshotsList_SelectionChanged"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Button Tag="{Binding Content}" Click="OpenScreenshot_Click" Padding="0" Margin="2"><Image Source="{Binding Content,Converter={StaticResource ImageConverter}}" Width="62" Height="58" Stretch="UniformToFill"/></Button></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
   <StackPanel Grid.Column="1" Margin="28,0,0,0"><TextBlock Text="商店游戏详情" FontSize="28" FontWeight="SemiBold"/>
    <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,14,0"><StackPanel x:Name="TranslatedNameSection"><TextBlock Text="译名"/><TextBox x:Name="TranslatedNameBox" IsReadOnly="True"/></StackPanel><StackPanel x:Name="OriginalNameSection" Margin="0,12,0,0"><TextBlock Text="原名"/><TextBox x:Name="OriginalNameBox" IsReadOnly="True"/></StackPanel><StackPanel x:Name="ClubSection" Margin="0,12,0,0"><TextBlock Text="社团名"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ClubNameBox" IsReadOnly="True"/><Button Grid.Column="1" Tag="ClubName" Click="SearchMetadata_Click" ToolTip="在商店浏览搜索"><TextBlock Text="⌕" FontSize="17"/></Button></Grid></StackPanel><StackPanel x:Name="AuthorsSection" Margin="0,12,0,0"><TextBlock Text="作者"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="AuthorsBox" IsReadOnly="True"/><Button Grid.Column="1" Tag="Authors" Click="SearchMetadata_Click" ToolTip="在商店浏览搜索"><TextBlock Text="⌕" FontSize="17"/></Button></Grid></StackPanel><StackPanel x:Name="IllustratorsSection" Margin="0,12,0,0"><TextBlock Text="插画师"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="IllustratorsBox" IsReadOnly="True"/><Button Grid.Column="1" Tag="Illustrators" Click="SearchMetadata_Click" ToolTip="在商店浏览搜索"><TextBlock Text="⌕" FontSize="17"/></Button></Grid></StackPanel><StackPanel x:Name="VoiceActorsSection" Margin="0,12,0,0"><TextBlock Text="声优"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="VoiceActorsBox" IsReadOnly="True"/><Button Grid.Column="1" Tag="VoiceActors" Click="SearchMetadata_Click" ToolTip="在商店浏览搜索"><TextBlock Text="⌕" FontSize="17"/></Button></Grid></StackPanel></StackPanel>
     <StackPanel Grid.Column="1"><StackPanel x:Name="ReleaseDateSection"><TextBlock Text="发售日"/><TextBox x:Name="ReleaseDateBox" IsReadOnly="True"/></StackPanel><StackPanel x:Name="WorkFormsSection" Margin="0,12,0,0"><TextBlock Text="作品形式"/><TextBox x:Name="WorkFormsBox" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel><StackPanel x:Name="StoreIdSection" Margin="0,12,0,0"><TextBlock Text="商店 ID"/><TextBox x:Name="StoreIdBox" IsReadOnly="True"/></StackPanel><StackPanel x:Name="StoreUrlSection" Margin="0,12,0,0"><TextBlock Text="商店链接"/><TextBox x:Name="StoreUrlBox" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel><StackPanel x:Name="CategoryTagsSection" Margin="0,12,0,0"><TextBlock Text="分类"/><TextBox x:Name="CategoryTagsBox" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel><StackPanel x:Name="FileSizeSection" Margin="0,12,0,0"><TextBlock Text="文件容量"/><TextBox x:Name="FileSizeBox" IsReadOnly="True"/></StackPanel><StackPanel x:Name="LanguagesSection" Margin="0,12,0,0"><TextBlock Text="支持的语言"/><TextBox x:Name="LanguagesBox" IsReadOnly="True"/></StackPanel><StackPanel x:Name="AgeRatingSection" Margin="0,12,0,0"><TextBlock Text="年龄指定"/><TextBox x:Name="AgeRatingBox" IsReadOnly="True"/></StackPanel><StackPanel x:Name="FeatureSection" Margin="0,12,0,0"><TextBlock Text="作品特性"/><TextBox x:Name="FeatureBox" IsReadOnly="True"/></StackPanel><StackPanel x:Name="SalesSection" Margin="0,12,0,0"><TextBlock Text="销量"/><TextBox x:Name="SalesBox" IsReadOnly="True"/></StackPanel><StackPanel x:Name="StoreRatingSection" Margin="0,12,0,0"><TextBlock Text="商店评分"/><TextBox x:Name="StoreRatingBox" IsReadOnly="True"/></StackPanel><StackPanel x:Name="LastRefreshSection" Margin="0,12,0,0"><TextBlock Text="上次刷新信息"/><TextBox x:Name="LastRefreshBox" IsReadOnly="True"/></StackPanel></StackPanel>
    </Grid><StackPanel x:Name="DescriptionSection" Margin="0,16,0,0"><TextBlock Text="作品内容" Margin="0,0,0,4"/><TextBox x:Name="DescriptionBox" IsReadOnly="True" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></StackPanel>
   </StackPanel>
  </Grid></ScrollViewer>
 </DockPanel>
</Page>
