<Page x:Class="LocalGameManager.Views.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LocalGameManager.Views" Background="{DynamicResource PageBackgroundBrush}" Loaded="Page_Loaded">
 <Page.Resources><local:ByteArrayImageConverter x:Key="ByteArrayImageConverter"/><DataTemplate x:Key="StatusIconTemplate"><Grid Width="22" Height="22" Margin="1" ToolTip="{Binding Title}"><TextBlock x:Name="TextIcon" Text="{Binding Glyph}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#D99D27"/><Viewbox x:Name="NewIcon" Visibility="Collapsed"><Canvas Width="24" Height="24"><Path Stroke="#D99D27" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M8.2,10.2 H12.3 A5.5,5.5 0 0 1 17.6,14.3 L18.4,17.3 A1.8,1.8 0 0 1 15.4,19.1 L13.7,17.6 H6.3 L4.6,19.1 A1.8,1.8 0 0 1 1.6,17.3 L2.4,14.3 A5.5,5.5 0 0 1 7.7,10.2 Z M6.2,14.8 H9.3 M7.75,13.25 V16.35 M13.7,14.8 H13.71 M16,13.8 H16.01 M17.7,3 L18.15,4.35 L19.5,4.8 L18.15,5.25 L17.7,6.6 L17.25,5.25 L15.9,4.8 L17.25,4.35 Z"/></Canvas></Viewbox><Viewbox x:Name="LocalizedIcon" Visibility="Collapsed"><Canvas Width="24" Height="24"><Path Stroke="#D99D27" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M4.5,5.5 H19.5 V15.5 H11.5 L7.5,18.5 V15.5 H4.5 A2,2 0 0 1 2.5,13.5 V7.5 A2,2 0 0 1 4.5,5.5 Z"/><TextBlock Text="汉" Foreground="#D99D27" FontWeight="Bold" FontSize="8.5" Width="24" TextAlignment="Center" Margin="0,6,0,0"/></Canvas></Viewbox><Viewbox x:Name="UncensoredIcon" Visibility="Collapsed"><Canvas Width="24" Height="24"><Path Stroke="#D99D27" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M3.5,6.5 H20.5 V17.5 H3.5 Z M7,6.5 V9.6 M12,6.5 V9.6 M17,6.5 V9.6 M3.5,12 H6.6 M9,12 H12 M15,12 H17.5 M7,17.5 V14.4 M12,17.5 V14.4 M17,17.5 V14.4 M3,20.5 L21,3"/></Canvas></Viewbox><Viewbox x:Name="AnimatedIcon" Visibility="Collapsed"><Canvas Width="24" Height="24"><Rectangle Width="14" Height="14" RadiusX="2" RadiusY="2" Canvas.Left="3" Canvas.Top="5" Stroke="#D99D27" StrokeThickness="1.8"/><Path Fill="#D99D27" Data="M9,9 L13,12 L9,15 Z"/><Path Stroke="#D99D27" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M20,7.5 C21.3,8.65 21.3,15.35 20,16.5 M18.3,9.5 C19,10.2 19,13.8 18.3,14.5"/></Canvas></Viewbox></Grid><DataTemplate.Triggers><DataTrigger Binding="{Binding Kind}" Value="New"><Setter TargetName="TextIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="NewIcon" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Localized"><Setter TargetName="TextIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="LocalizedIcon" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Uncensored"><Setter TargetName="TextIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="UncensoredIcon" Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Animated"><Setter TargetName="TextIcon" Property="Visibility" Value="Collapsed"/><Setter TargetName="AnimatedIcon" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></Page.Resources>
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="游戏库" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock x:Name="StatusText" Text="大图标视图" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="AutoUpdateButton" Content="批量自动更新" Click="AutoUpdateButton_Click"/><Button Content="扫描文件夹" Click="ScanButton_Click"/><Button Content="+ 添加游戏" Click="AddGameButton_Click" Background="#5267D5" Foreground="White" BorderBrush="Transparent"/></StackPanel></Grid>
  <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,22,0,14" Padding="10,7" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" ToolTip="搜索游戏名称、社团、作者、插画师或声优；以 @ 开头并按 Enter 使用 AI 搜索"/>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="筛选标签（同时包含）" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="同一类型分组显示；选中多个标签时采用 AND 条件。" TextWrapping="Wrap" Margin="0,6,0,10" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/><Button Content="清除标签筛选" Click="ClearFilters_Click" HorizontalAlignment="Left"/><TextBlock Text="已选" FontWeight="SemiBold" Margin="0,10,0,3"/><WrapPanel x:Name="SelectedFiltersPanel"/><StackPanel x:Name="FilterPanel" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Border>
   <Border Grid.Column="1" Margin="14,0,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Button x:Name="ViewModeButton" Click="ToggleView_Click" ToolTip="切换大图标/详细信息视图"><Viewbox Width="18" Height="18"><Path Fill="{DynamicResource TextPrimaryBrush}" Data="M3 5.25A2.25 2.25 0 0 1 5.25 3h13.5A2.25 2.25 0 0 1 21 5.25v2.5A2.25 2.25 0 0 1 18.75 10H5.25A2.25 2.25 0 0 1 3 7.75v-2.5Zm0 11A2.25 2.25 0 0 1 5.25 14h13.5A2.25 2.25 0 0 1 21 16.25v2.5A2.25 2.25 0 0 1 18.75 21H5.25A2.25 2.25 0 0 1 3 18.75v-2.5Z"/></Viewbox></Button></StackPanel>
    <Grid Grid.Row="1"><ListBox x:Name="GamesList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" HorizontalContentAlignment="Stretch" MouseLeftButtonUp="GamesList_LeftClick" MouseRightButtonUp="GamesList_RightClick" KeyDown="GamesList_KeyDown"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="190" Height="285" Margin="7" Padding="12" Background="{DynamicResource SurfaceBrush}" CornerRadius="7"><Grid><Grid.RowDefinitions><RowDefinition Height="132"/><RowDefinition Height="72"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions><Border Grid.Row="0" Background="#394D7E" CornerRadius="5"><Grid><Image Source="{Binding CoverThumbnail, Converter={StaticResource ByteArrayImageConverter}}" Stretch="UniformToFill"/><TextBlock Text="封面" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65"/></Grid></Border><TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="20" VerticalAlignment="Center" MaxHeight="60"/><ItemsControl Grid.Row="2" ItemsSource="{Binding StatusIcons}" ItemTemplate="{StaticResource StatusIconTemplate}" HorizontalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl><TextBlock Grid.Row="3" Text="{Binding RatingStars}" Foreground="#D99D27" TextAlignment="Center" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
     <ListView x:Name="GamesDetailsList" Visibility="Collapsed" MouseLeftButtonUp="GamesDetailsList_LeftClick" MouseRightButtonUp="GamesDetailsList_RightClick" KeyDown="GamesDetailsList_KeyDown"><ListView.View><GridView><GridViewColumn Header="名称" Width="180" DisplayMemberBinding="{Binding DisplayName}"/><GridViewColumn Header="游戏状态" Width="130"><GridViewColumn.CellTemplate><DataTemplate><ItemsControl ItemsSource="{Binding StatusIcons}" ItemTemplate="{StaticResource StatusIconTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="评分" Width="100" DisplayMemberBinding="{Binding RatingStars}"/><GridViewColumn Header="作品形式与分类" Width="210" DisplayMemberBinding="{Binding TagSummary}"/><GridViewColumn Header="启动信息" Width="170" DisplayMemberBinding="{Binding LaunchSummary}"/><GridViewColumn Header="入库时间" Width="135" DisplayMemberBinding="{Binding AddedLabel}"/></GridView></ListView.View></ListView>
    </Grid>
   </Grid></Border>
  </Grid>
 </Grid>
</Page>
