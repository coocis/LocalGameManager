<Window x:Class="LocalGameManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="本地游戏管理器" Height="760" Width="1240" MinHeight="620" MinWidth="960" Background="{DynamicResource PageBackgroundBrush}"><Grid><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid Margin="18,8"><TextBlock Text="游戏管理器" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="☼ / ◐" Click="ToggleTheme_Click" ToolTip="切换黑夜模式"/></Grid></Border><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource SidebarBrush}" Padding="16"><StackPanel><TextBlock Text="LOCAL LIBRARY" Foreground="#8E99B7" FontSize="11"/><TextBlock Text="游戏库" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0,4,0,24"/><Button Content="游戏库" Tag="Library" Click="NavigateButton_Click" Style="{StaticResource NavigationButtonStyle}"/><Button Content="商店浏览" Tag="Store" Click="NavigateButton_Click" Style="{StaticResource NavigationButtonStyle}"/><Button Content="统计信息" Tag="Statistics" Click="NavigateButton_Click" Style="{StaticResource NavigationButtonStyle}"/><Button Content="标签管理" Tag="Tags" Click="NavigateButton_Click" Style="{StaticResource NavigationButtonStyle}"/><Button Content="设置" Tag="Settings" Click="NavigateButton_Click" Style="{StaticResource NavigationButtonStyle}"/></StackPanel></Border><Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/></Grid></Grid></Window>
