<Page x:Class="LocalGameManager.Views.StoreImageViewerPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LocalGameManager.Views" Background="{DynamicResource PageBackgroundBrush}"><Page.Resources><local:ByteArrayImageConverter x:Key="ImageConverter"/></Page.Resources><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="82"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="← 返回详情" Click="Back_Click"/><TextBlock x:Name="TitleText" Margin="12,0" VerticalAlignment="Center" FontSize="18"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Button Content="‹" FontSize="36" Click="Previous_Click"/><Border Grid.Column="1" Background="#202B46" CornerRadius="8"><Image x:Name="MainImage" Stretch="Uniform"/></Border><Button Grid.Column="2" Content="›" FontSize="36" Click="Next_Click"/></Grid><ListBox x:Name="Thumbnails" Grid.Row="2" SelectionChanged="Thumbnails_SelectionChanged" HorizontalContentAlignment="Left"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Image Source="{Binding Converter={StaticResource ImageConverter}}" Width="74" Height="68" Margin="3" Stretch="UniformToFill"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Page>
